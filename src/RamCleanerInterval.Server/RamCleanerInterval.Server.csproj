<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Optional SPT server part: lists the RAM cleaner's in-game web page in the SPT launcher's /
       web panel "mod pages" and serves it at https://<server>/ramcleaner/ by forwarding to the game's
       local page (http://127.0.0.1:<port>/). It does nothing else. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RamCleanerInterval.Server</RootNamespace>
    <AssemblyName>RamCleanerInterval.Server</AssemblyName>
    <Version>2.12.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- All of these ship with the SPT server: compile against them, never copy them. -->
  <ItemGroup>
    <PackageReference Include="SPTushonka.Common" Version="4.1.5" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="SPTushonka.DI" Version="4.1.5" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.5" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="SPTushonka.Server.Web" Version="4.1.5" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
