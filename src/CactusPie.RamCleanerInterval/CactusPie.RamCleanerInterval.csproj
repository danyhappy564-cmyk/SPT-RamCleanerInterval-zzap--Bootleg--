<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\RamCleaner.local.props" Condition="Exists('..\RamCleaner.local.props')" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>CactusPie.RamCleanerInterval</AssemblyName>
    <RootNamespace>CactusPie.RamCleanerInterval</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <VersionPrefix>2.12.0</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <Authors>CactusPie (original), R_F (SPT 4.1 port)</Authors>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <SptRoot Condition="'$(SptRoot)' == '' And '$(SPT_ROOT)' != ''">$(SPT_ROOT)</SptRoot>
    <!-- Fork default: the maintainer's SPT 4.1 install. Override with -p:SptRoot=..., the
         SPT_ROOT environment variable, or src\RamCleaner.local.props. -->
    <SptRoot Condition="'$(SptRoot)' == ''">E:\SPT 4.1</SptRoot>
    <!-- Release builds deploy straight into the SPT install by default (also from Visual Studio). -->
    <DeployPlugin Condition="'$(DeployPlugin)' == '' And '$(Configuration)' == 'Release'">true</DeployPlugin>
    <DeployPlugin Condition="'$(DeployPlugin)' == ''">false</DeployPlugin>
    <Managed>$(SptRoot)\EscapeFromTarkov_Data\Managed</Managed>
    <BepInExCore>$(SptRoot)\BepInEx\core</BepInExCore>
    <PluginFolder>BepInEx\plugins\CactusPie.RamCleanerInterval</PluginFolder>
  </PropertyGroup>

  <!-- No spt-reflection reference: the plugin does not patch game code. 0Harmony (from BepInEx\core) is
       only used by the optional mod profiler to wrap other mods' methods with timing hooks. -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(Managed)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(Managed)\Comfort.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(Managed)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(Managed)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(Managed)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Web page assets (18. Web page), read with GetManifestResourceStream("web.<file>"). -->
  <ItemGroup>
    <EmbeddedResource Include="Web\*.css;Web\*.js" LogicalName="web.%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="ValidateSptRoot" BeforeTargets="ResolveReferences"
          Condition="'$(SptRoot)' == '' Or !Exists('$(SptRoot)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll')">
    <Error Text="Set SptRoot to a valid SPT installation using -p:SptRoot=&quot;C:\Path\To\SPT&quot;, the SPT_ROOT environment variable, or src\RamCleaner.local.props." />
  </Target>

  <!-- Optional SPT server part (..\RamCleanerInterval.Server): lists the web page in the SPT launcher's mod pages.
       Built with every Release build (needs the .NET 10 SDK); skip with -p:SkipServer=true. -->
  <PropertyGroup>
    <ServerProject>$(MSBuildThisFileDirectory)..\RamCleanerInterval.Server\RamCleanerInterval.Server.csproj</ServerProject>
    <ServerDll>$(MSBuildThisFileDirectory)..\RamCleanerInterval.Server\bin\Release\RamCleanerInterval.Server.dll</ServerDll>
    <ServerFolder>SPT_Runtime\user\mods\RamCleanerInterval.Server</ServerFolder>
  </PropertyGroup>

  <Target Name="BuildServerPart" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' AND '$(SkipServer)' != 'true'">
    <MSBuild Projects="$(ServerProject)" Targets="Restore" Properties="Configuration=Release" />
    <MSBuild Projects="$(ServerProject)" Targets="Build" Properties="Configuration=Release" />
  </Target>

  <Target Name="DeployToSpt" AfterTargets="Build" DependsOnTargets="BuildServerPart" Condition="'$(DeployPlugin)' == 'true'">
    <MakeDir Directories="$(SptRoot)\$(PluginFolder)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptRoot)\$(PluginFolder)" />
    <Message Text="Deployed $(TargetFileName) to $(SptRoot)\$(PluginFolder)" Importance="high" />
    <Copy Condition="Exists('$(ServerDll)') AND '$(SkipServer)' != 'true'" SourceFiles="$(ServerDll)" DestinationFolder="$(SptRoot)\$(ServerFolder)" />
  </Target>

  <!-- Rule 2-2: every Release build also drops a ready-to-extract archive (unzip into the SPT folder)
       in the repository's release\ folder. Skip with -p:SkipPackage=true. -->
  <Target Name="PackageRelease" AfterTargets="Build" DependsOnTargets="BuildServerPart"
          Condition="'$(Configuration)' == 'Release' AND '$(SkipPackage)' != 'true'">
    <PropertyGroup>
      <PackageStageDir>$(IntermediateOutputPath)package\</PackageStageDir>
      <PackageZipDir>$(MSBuildThisFileDirectory)..\..\release\</PackageZipDir>
      <PackageZipPath>$(PackageZipDir)RamCleanerInterval-$(Version)-SPT4.1.zip</PackageZipPath>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageStageDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageStageDir)$(PluginFolder)" />
    <Copy Condition="Exists('$(ServerDll)') AND '$(SkipServer)' != 'true'" SourceFiles="$(ServerDll)" DestinationFolder="$(PackageStageDir)$(ServerFolder)" />
    <MakeDir Directories="$(PackageZipDir)" />
    <Delete Files="$(PackageZipPath)" />
    <ZipDirectory SourceDirectory="$(PackageStageDir)" DestinationFile="$(PackageZipPath)" Overwrite="true" />
    <Message Text="Packaged $(PackageZipPath)" Importance="high" />
  </Target>

</Project>
